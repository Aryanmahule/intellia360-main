# ─────────────────────────────────────────────────────────────────────────────
# Backend (API) environment. Copy to apps/backend/.env (read by Next.js, the
# Prisma CLI, the seed and the db:* scripts) and fill in real values. .env.local
# also works for everything except the Prisma CLI. The frontend has its own
# template: apps/frontend/.env.example. Never commit real credentials — every
# .env* file except these templates is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (MongoDB) ──────────────────────────────────────────────────────
# MongoDB Atlas (recommended) or local MongoDB via docker-compose.yml
# docker-compose.yml provides: mongodb://root:example@localhost:27017/intellia360?authSource=admin
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/intellia360

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Minimum 32 chars — shorter will cause a hard startup crash.
AUTH_JWT_SECRET=change-me-generate-at-least-64-random-chars
AUTH_JWT_EXPIRES_IN=7d

# ─── Platform super-admin ────────────────────────────────────────────────────
# The single account `prisma/seed.ts` creates with role=ADMIN, and the identity
# POST /api/admin/seed-admin bootstraps. Set these so a reseed always restores
# the owner's admin access.
#
# ADMIN_PASSWORD is never committed: without it the seed falls back to the
# shared demo password (and warns), and the seed-admin endpoint refuses to run.
ADMIN_EMAIL=intelliasg@gmail.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=change-me-before-seeding

# ─── Frontend URL & CORS ──────────────────────────────────────────────────────
# Public URL of the FRONTEND (apps/frontend). Used to build the links in
# verification and password-reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call this API with the session cookie
# (comma-separated, scheme + host [+ port], no trailing slash). Requests from any
# other site are refused CORS access, and their POST/PUT/PATCH/DELETE get 403.
# Production example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ─── AI tutor — Groq ─────────────────────────────────────────────────────────
# Server-side only, used by POST /api/student/ai-tutor. Without a key the tutor
# reports "AI Tutor is not configured."
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.1-8b-instant

# ─── Email — Resend ───────────────────────────────────────────────────────────
# Sign up free at https://resend.com → API Keys
# Without a verified domain: RESEND_FROM=Intellia360 <onboarding@resend.dev>
# With a verified domain:    RESEND_FROM=Intellia360 <noreply@yourdomain.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Intellia360 <onboarding@resend.dev>

# Email verification. Unset or false: accounts are verified instantly at
# sign-up and sign-in. true: the emailed link is required, which needs a
# verified RESEND_FROM domain and a public NEXT_PUBLIC_APP_URL.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create project
# 2. APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorised JavaScript origins: http://localhost:3000 (dev) + your prod
#    frontend domain
# 5. Copy the Client ID below (no Client Secret needed for ID-token flow). The
#    frontend needs the same id as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Read by POST /api/auth/google to verify the ID token's audience. Google
# sign-in fails with a 500 when this is unset.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Server-side secret (optional — only needed for server-side code exchange flow)
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Backups & retention ──────────────────────────────────────────────────────
# Used by scripts/backup.mjs, restore.mjs, verify-backup.mjs and db-maintenance.mjs.
# Full runbook: docs/DATABASE-BACKUP-RECOVERY.md
#
# Local archive directory and how many archives to keep on disk.
BACKUP_DIR=backups
BACKUP_KEEP=14
#
# OFF-SITE COPY (strongly recommended — a backup stored only on the machine that
# produced it does not survive host loss, ransomware or an accidental wipe).
# Works with any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2,
# Wasabi, MinIO. Use a WRITE-ONLY key scoped to this bucket, and enable the
# provider's object-lock / versioning so backups cannot be deleted or
# overwritten by a compromised key.
# BACKUP_S3_BUCKET=intellia360-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=<account>.r2.cloudflarestorage.com
# BACKUP_S3_PREFIX=intellia360
#
# Retention windows for the nightly maintenance sweep (all optional).
# RATE_LIMIT_RETENTION_HOURS=24
# TOKEN_RETENTION_DAYS=7
# AUDIT_RETENTION_DAYS=730
# BACKUP_RUN_RETENTION_DAYS=365
# CURRICULUM_REVISIONS_KEPT=20
