# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment. Copy to apps/frontend/.env.local for development.
#
# Every variable here is NEXT_PUBLIC_*: it is compiled into the JavaScript that
# browsers download, at build time. Put nothing secret in this file. In CI the
# production values come from GitHub repository variables
# (.github/workflows/frontend-deploy.yml); changing one needs a rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend API (apps/backend), no trailing slash.
# Development: the backend's `next dev` port. Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google sign-in button (Google Identity Services). The same OAuth client id as
# GOOGLE_CLIENT_ID in apps/backend/.env. Without it the button is shown disabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
